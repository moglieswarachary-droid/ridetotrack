# ==============================================================================
# RideTrack Backend Environment Configuration
# ==============================================================================

ENVIRONMENT=development
DEBUG=true

SECRET_KEY=ridetrack-super-secret-development-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SHARE_TOKEN_DEFAULT_HOURS=12

# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./ridetrack.db

# Redis URL:
REDIS_URL=redis://localhost:6379/0

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=*
