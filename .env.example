# ==============================================================================
# RideTrack Environment Configuration
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=production
DEBUG=false

# Security (Generate a secure random string in production)
SECRET_KEY=ridetrack-production-super-secret-key-change-in-prod-7829471923
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SHARE_TOKEN_DEFAULT_HOURS=12

# Database Configuration
# Local SQLite Default:
# DATABASE_URL=sqlite+aiosqlite:///./ridetrack.db
# Production PostgreSQL + PostGIS (Docker Compose):
DATABASE_URL=postgresql+asyncpg://ridetrack_user:ridetrack_secure_password_2026@postgres:5432/ridetrack

# Redis State Store & Pub/Sub
# Local: redis://localhost:6379/0
# Production (Docker Compose):
REDIS_URL=redis://redis:6379/0

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma separated or * for open dev/test)
CORS_ORIGINS=*
